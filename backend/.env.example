PORT=5000

# Replace the placeholder below with your Atlas connection string. Do NOT commit real credentials into the repo.
# Example (replace <username> and <password> with your credentials - do NOT include angle brackets):
# MONGO_URI="mongodb+srv://<username>:<password>@cluster0.<id>.mongodb.net/jobconnect?retryWrites=true&w=majority&appName=Cluster0"

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.<id>.mongodb.net/jobconnect?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
